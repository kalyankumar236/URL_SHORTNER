# ---------------------------------------------------------------------------
# Agentic SDLC Platform — Example environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Spring profile selection -----------------------------------------------
# dev    -> H2 in-memory DB, mock LLM provider (default, no Docker needed)
# docker -> PostgreSQL + Redis via docker-compose
# prod   -> externally managed PostgreSQL + Redis
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL (used by docker/prod profiles) ------------------------------
POSTGRES_DB=agentic
POSTGRES_USER=agentic
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (optional, used by docker/prod profiles) -------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security ---------------------------------------------------------------
# Admin credentials for protected orchestration/admin endpoints (demo only).
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-in-real-env

# --- LLM provider adapter ---------------------------------------------------
# provider: mock (deterministic, offline) | openai | azure-openai
LLM_PROVIDER=mock
# Only required when LLM_PROVIDER != mock. Keep OUT of source control.
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=

# --- URL shortener base URL (used to build returned short links) ------------
APP_SHORT_BASE_URL=http://localhost:8080
